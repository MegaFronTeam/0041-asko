extends ../layout/main.pug

include ../blocks/sCatalog/_sCatalog.pug
include ../blocks/sAddresses/_sAddresses.pug
include ../blocks/sOfferTop/_sOfferTop.pug
include ../blocks/sOfferList/_sOfferList.pug
include ../blocks/sOfferTotal/_sOfferTotal.pug

block variables
	- let  mainPage= ''
	- let  bg= 'main.jpg'

block title
	- let  title= "14 - Коммерческое предложение"
	title= title
block pagecontent
	+parts('header')
	main
		.container.py-2
			+breadcrumb("Бытовая техника ASKO", 'Коммерческое предложение')
		+sOfferTop
		+sOfferList
		+sOfferTotal
		+sAddresses.d-md-none
	+parts('footer')
