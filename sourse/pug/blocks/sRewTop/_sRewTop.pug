mixin sRewTop(data)
	// start sRewTop
	+b.SECTION.sRewTop.section#sRewTop&attributes(attributes)
		.container
			+e.inner
				+e.photo
					img(src="img/rew2-hero.jpg" alt="")
				+e.txt
					h1.sRewTop__title Нам важно ваше мнение
					p.sRewTop__desc Расскажите нам о своём опыте — поделитесь благодарностью или сообщите, если что-то пошло не так
					p.sRewTop__note Мы хотим, чтобы покупка техники приносила только положительные впечатления
				+e.phone
					img(src="img/rew2-phone.png" width="300" height="458" alt="Отзывы о технике ASKO")
	// end sRewTop
