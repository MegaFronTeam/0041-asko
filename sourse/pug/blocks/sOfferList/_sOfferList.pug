mixin offer-item(item)
	+e.ARTICLE.item
		+e.card
			+e.main
				+e.img-wrap
					+img(item.img)(alt=item.title)
				+e.caption
					+e.cat= item.cat
					+e.title= item.title
					.product-item__icons.row.g-2
						if item.rating
							.product-item__icon.product-item__icon--rating.col-auto
								+icon("star")
								| #{item.rating}
						.product-item__icon.product-item__icon--comments.col-auto
							+icon("chart")
							| 0
					p.sOfferList__desc= item.desc
					+e.prices
						+e.price= item.price
						+e.price-old= item.priceOld
						+e.discount скидка 10%
					.product-item__purchase
						.product-item__purchase-img-wrap: img(src="img/purchase-1.png", alt="")
						.product-item__purchase-img-wrap: img(src="img/purchase-2.png", alt="")
			+e.aside
				+e.totals
					div
						+e.label Количество
						+e.value= item.amount
					div
						+e.label Сумма
						+e.value= item.sum
				dl.sOfferList__props
					dt Артикул:
					dd= item.article
					dt Наличие:
					dd В наличии · Поставка: 24.10.2026
					dt Гарантия:
					dd 12 месяца
			button.sOfferList__toggle.sOfferList__toggle--js(type="button" aria-expanded="false" aria-label="Подробнее о товаре")
				span
					+icon("chevron-down")
		+offer-body(item)

